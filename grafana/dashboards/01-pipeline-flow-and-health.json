        "negotiator-link"
      ],
      "targetBlank": false,
      "title": "negotiator-link dashboards",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "negotiator-link",
    "observability",
    "reliability"
