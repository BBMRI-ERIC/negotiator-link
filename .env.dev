# Development environment configuration, used directly by docker compose. See README.md

# Webhook signing secret — must match the secret configured in the Negotiator webhook entity.
NEGOTIATOR_WEBHOOK_SECRET=whsec_bG9jYWwtZGV2LXdlYmhvb2stc2VjcmV0

# Negotiator Docker image tag — override to test a specific branch or version
NEGOTIATOR_TAG=master

# Zammad bot API token used by negotiator-link for its outbound API calls.
ZAMMAD_API_TOKEN=negotiator-link-dev-bot-token-change-me-0123456789abcdef

# Shared secret for verifying inbound Zammad webhook callbacks (HMAC SHA1 token).
ZAMMAD_CALLBACK_SECRET=whsec_bG9jYWwtZGV2LXdlYmhvb2stc2VjcmV0
