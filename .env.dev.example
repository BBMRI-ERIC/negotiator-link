# Webhook signing secret — must match the secret configured in the Negotiator webhook entity.
NEGOTIATOR_WEBHOOK_SECRET=local-dev-webhook-secret

# Negotiator Docker image tag — override to test a specific branch or version
NEGOTIATOR_TAG=master

# Zammad organization credentials — obtain API token from Zammad Admin > Integrations > API Token
# after completing the Zammad first-time setup wizard at http://localhost:8888
ZAMMAD_MHH_API_TOKEN=your-zammad-api-token-here
ZAMMAD_MHH_CALLBACK_SECRET=whsec_bG9jYWwtZGV2LXdlYmhvb2stc2VjcmV0