# Production environment template for negotiator-link.

# --- Database ---
# Password for the negotiator-link PostgreSQL instance
DB_PASSWORD=

# --- Negotiator ---
# Base URL of the Negotiator API.
NEGOTIATOR_BASE_URL=https://negotiator.acc.bbmri-eric.eu/api

# OIDC issuer URI that issues OAuth2 client-credentials tokens for the Negotiator
# Needs to be confirmed the exact issuer URI with the Negotiator administrator.
NEGOTIATOR_ISSUER_URI=https://login.aai.lifescience-ri.eu/oidc/

# OAuth2 client credentials registered in Negotiator for this middleware,
# per organization. Obtain from the Negotiator administrator.
NEGOTIATOR_CLIENT_ORG1_ID=
NEGOTIATOR_CLIENT_ORG1_SECRET=

# Shared secret used to verify inbound Negotiator webhook signatures.
# Must match the secret configured in the Negotiator webhook entity. Confirm with Negotiator administrator.
NEGOTIATOR_WEBHOOK_SECRET=

# --- Helpdesk organization credentials ---
# API token of the negotiator-link Helpdesk bot user and the shared secret used to verify inbound callbacks.
ZAMMAD_ORG1_API_TOKEN=
ZAMMAD_ORG1_CALLBACK_SECRET=