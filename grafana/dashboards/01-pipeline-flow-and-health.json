        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(tasks_scheduled_execution_seconds_count{code_namespace=~\".*InboxPoller\", code_function=\"poll\"}[5m]))",
