# Production environment template for negotiator-link.
#
# Copy this file to `.env` in the deployment directory on the VM and fill in
# the real values. Docker Compose automatically loads `.env` from the working
# directory when you run `docker compose -f compose.prod.yml ...`.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ SAFE TO COMMIT: this .env.production.example file (placeholders only).    │
# │ NEVER COMMIT:   the filled-in .env on the VM — it holds real secrets.     │
# └─────────────────────────────────────────────────────────────────────────┘
# The application fails to start if a required variable is missing, so every
# entry below must be set to a real value before `docker compose up`.

# --- Database ---
# Password for the negotiator-link PostgreSQL instance (used by both the app
# and the postgres container). Choose a strong value.
DB_PASSWORD=change-me-strong-password

# --- Negotiator ---
# Base URL of the Negotiator API. Must include the "/api" path — the API lives
# under /api (verify with: curl -I <base-url>/actuator/health -> 200).
NEGOTIATOR_BASE_URL=https://negotiator.acc.bbmri-eric.eu/api

# OIDC issuer URI that issues OAuth2 client-credentials tokens for the Negotiator
# Needs to be confirmed the exact issuer URI with the Negotiator administrator.
NEGOTIATOR_ISSUER_URI=https://login.aai.lifescience-ri.eu/oidc/

# OAuth2 client credentials registered in Negotiator for this middleware,
# per organization. Obtain from the Negotiator administrator.
NEGOTIATOR_CLIENT_ORG1_ID=
NEGOTIATOR_CLIENT_ORG1_SECRET=

# Shared secret used to verify inbound Negotiator webhook signatures.
# Must match the secret configured in the Negotiator webhook entity. Confirm with Negotiator administrator.
NEGOTIATOR_WEBHOOK_SECRET=

# --- Helpdesk organization credentials ---
# API token of the negotiator-link Helpdesk bot user (e.g. in Zammad get Zammad Admin > Profile >
# Token Access) and the shared secret used to verify inbound callbacks (e.g. the same secret provided in Zammad webhook).
ZAMMAD_ORG1_API_TOKEN=
ZAMMAD_ORG1_CALLBACK_SECRET=